# Copy via `make env` (generates random local secrets). Never commit .env.
# Classic compose builder: bake fails on non-ASCII project paths (see README).
COMPOSE_BAKE=false
APP_ENV=development
DATASET=core
WEB_PORT=8080
APP_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=<generated-by-make-env>
JWT_SECRET=<generated-by-make-env>
CSRF_SECRET=<generated-by-make-env>
JWT_TTL_SECONDS=1800
COOKIE_SECURE=false
PROVIDER_BASE_URL=http://provider:8091
PROVIDER_PUBLISH_PORT=18091
PROVIDER_TIMEOUT_MS=5000
RETRY_DELAY_MS=6000
JOB_LEASE_MS=30000
WORKER_POLL_MS=500
WORKER_CONCURRENCY=1
LOG_LEVEL=info
